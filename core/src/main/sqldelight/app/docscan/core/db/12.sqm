CREATE TABLE PublicExportPublication (
  export_artifact_id TEXT NOT NULL PRIMARY KEY REFERENCES ExportArtifact(export_artifact_id),
  document_uri TEXT NOT NULL CHECK (substr(document_uri, 1, 10) = 'content://'),
  display_name TEXT NOT NULL CHECK (length(trim(display_name)) > 0),
  page_count INTEGER NOT NULL CHECK (page_count > 0),
  ocr_status TEXT NOT NULL CHECK (ocr_status IN ('FULL', 'PARTIAL', 'NONE'))
);

ALTER TABLE ExternalExportPackage ADD COLUMN include_jpg INTEGER NOT NULL DEFAULT 1;
